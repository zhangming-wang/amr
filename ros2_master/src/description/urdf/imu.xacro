<robot xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:property name="imu_length" value="0.016" />
    <xacro:property name="imu_width" value="0.021" />
    <xacro:property name="imu_height" value="0.0015" />

    <xacro:macro name="imu" params="name joint_xyz parent_name">
        <link name="${name}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${imu_length} ${imu_width} ${imu_height}" />
                </geometry>
                <material name="purple">
                    <color rgba="1.0 0.0 1.0 1" />
                </material>
            </visual>

            <collision>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <geometry>
                    <box size="${imu_length} ${imu_width} ${imu_height}" />
                </geometry>
            </collision>
        </link>

        <joint name="${name}_joint" type="fixed">
            <parent link="${parent_name}" />
            <child link="${name}" />
            <origin xyz="${joint_xyz}" rpy="0 0 0" />
        </joint>
    </xacro:macro>
</robot>