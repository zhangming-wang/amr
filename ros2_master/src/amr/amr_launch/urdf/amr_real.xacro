<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="amr_real">
    <xacro:property name="base_link" value="base_link" />
    <xacro:property name="lidar_link" value="lidar_frame" />
    <xacro:property name="camera_link" value="camera_frame" />
    <xacro:property name="imu_link" value="imu_frame" />

    <xacro:property name="left_front_wheel" value="left_front_wheel" />
    <xacro:property name="left_back_wheel" value="left_back_wheel" />
    <xacro:property name="right_front_wheel" value="right_front_wheel" />
    <xacro:property name="right_back_wheel" value="right_back_wheel" />

    <xacro:include filename="$(find amr_launch)/urdf/base.xacro" />
    <xacro:include filename="$(find amr_launch)/urdf/wheel.xacro" />
    <xacro:include filename="$(find amr_launch)/urdf/castor.xacro" />
    <xacro:include filename="$(find amr_launch)/urdf/lidar.xacro" />
    <xacro:include filename="$(find amr_launch)/urdf/camera.xacro" />
    <xacro:include filename="$(find amr_launch)/urdf/imu.xacro" />

    <xacro:base name="${base_link}" joint_xyz="0 0 ${wheel_radius}" />
    <xacro:lidar name="${lidar_link}" joint_xyz="-${base_width/4} 0 ${lidar_height/2}" parent_name="${base_link}" />
    <xacro:camera name="${camera_link}" joint_xyz="${base_length/2-camera_support_width/2} 0 ${camera_support_height/2}" parent_name="${base_link}" />
    <xacro:imu name="${imu_link}" joint_xyz="0 0 ${imu_height/2+base_height/2}" parent_name="${base_link}" />

    <xacro:wheel name="${left_front_wheel}" joint_xyz="${base_width/2+wheel_width/2} ${base_length/2} 0" fdir1_value="1 1 1" parent_name="${base_link}" />
    <xacro:wheel name="${left_back_wheel}" joint_xyz="-${base_width/2+wheel_width/2} ${base_length/2} 0" fdir1_value="1 1 1" parent_name="${base_link}" />
    <xacro:wheel name="${right_front_wheel}" joint_xyz="${base_width/2+wheel_width/2} -${base_length/2} 0" fdir1_value="1 1 1" parent_name="${base_link}" />
    <xacro:wheel name="${right_back_wheel}" joint_xyz="-${base_width/2+wheel_width/2} -${base_length/2} 0" fdir1_value="1 1 1" parent_name="${base_link}" />

    <ros2_control name="ros2_controllers" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <joint name="${left_front_wheel}_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>
        <joint name="${left_back_wheel}_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>
        <joint name="${right_front_wheel}_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>
        <joint name="${right_back_wheel}_joint">
            <command_interface name="velocity" />
            <state_interface name="velocity" />
            <state_interface name="position" />
        </joint>
    </ros2_control>

</robot>