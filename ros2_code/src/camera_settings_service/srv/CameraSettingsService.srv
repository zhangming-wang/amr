# 请求部分（Request）
# 基础控制参数
int64 id  

int32 xclk_freq_hz             # XCLK时钟频率（Hz）
int16 milliseconds             # 延时参数（毫秒）
int16 aec_value                # 自动曝光值（0-1200）

int8 mode                    

# 摄像头硬件配置参数（初始化时生效）
int8 pin_pwdn                 # GPIO引脚：摄像头电源关闭线
int8 pin_reset                # GPIO引脚：摄像头复位线
int8 pin_xclk                 # GPIO引脚：摄像头XCLK时钟线
int8 pin_sccb_sda             # GPIO引脚：摄像头SDA线（I2C数据）
int8 pin_sccb_scl             # GPIO引脚：摄像头SCL线（I2C时钟）
int8 pin_d7                   # GPIO引脚：摄像头D7数据线
int8 pin_d6                   # GPIO引脚：摄像头D6数据线
int8 pin_d5                   # GPIO引脚：摄像头D5数据线
int8 pin_d4                   # GPIO引脚：摄像头D4数据线
int8 pin_d3                   # GPIO引脚：摄像头D3数据线
int8 pin_d2                   # GPIO引脚：摄像头D2数据线
int8 pin_d1                   # GPIO引脚：摄像头D1数据线
int8 pin_d0                   # GPIO引脚：摄像头D0数据线
int8 pin_vsync                # GPIO引脚：摄像头VSYNC线
int8 pin_href                 # GPIO引脚：摄像头HREF线
int8 pin_pclk                 # GPIO引脚：摄像头PCLK线
int8 ledc_timer               # 用于生成XCLK的LEDC定时器（枚举值转int）
int8 ledc_channel             # 用于生成XCLK的LEDC通道（枚举值转int）
int8 pixel_format             # 像素格式（PIXFORMAT_*枚举值转int）
int8 frame_size               # 输出图像尺寸（FRAMESIZE_*枚举值转int）
int8 jpeg_quality             # JPEG输出质量（0-63，值越小质量越高）
int8 fb_count                 # 帧缓冲区数量
int8 fb_location              # 帧缓冲区分配位置（camera_fb_location_t枚举值转int）
int8 grab_mode                # 缓冲区填充时机（camera_grab_mode_t枚举值转int）
int8 conv_mode                # RGB<->YUV转换模式（camera_conv_mode_t枚举值转int，可选）
int8 sccb_i2c_port            # SCCB I2C总线端口号（若pin_sccb_sda为-1时使用）

# 摄像头运行时参数（可动态调节）

int8 pixformat                # 像素格式（PIXFORMAT_*枚举值转int）
int8 framesize                # 帧大小（FRAMESIZE_*枚举值转int）
int8 quality                  # 图像质量（0-63）
int8 brightness               # 亮度（-2到+2）
int8 contrast                 # 对比度（-2到+2）
int8 saturation               # 饱和度（-2到+2）
int8 sharpness                # 锐度（-2到+2）
int8 denoise                  # 降噪等级（0-6）
int8 special_effect           # 特殊效果（0-6，如0=正常、1=负片）
int8 wb_mode                  # 白平衡模式（0-4）
int8 awb                 # 白平衡（0=禁用，1=启用）
int8 awb_gain                 # 白平衡增益（0=禁用，1=启用）
int8 aec            # 曝光控制（0=禁用，1=启用）
int8 aec2                     # 高级曝光控制（0=禁用，1=启用）
int8 ae_level                 # 曝光补偿（-2到+2）
int8 agc                # 增益控制（0=禁用，1=启用）
int8 agc_gain                 # 自动增益值（0-31）
int8 gainceiling              # 增益上限（gainceiling_t枚举值转int）
int8 bpc                      # 坏点校正（0=禁用，1=启用）
int8 wpc                      # 白点校正（0=禁用，1=启用）
int8 raw_gma                  # 原始图像GMA（0=禁用，1=启用）
int8 lenc                     # 镜头校正（0=禁用，1=启用）
int8 hmirror                  # 水平镜像（0=禁用，1=启用）
int8 vflip                    # 垂直翻转（0=禁用，1=启用）
int8 dcw                      # 数字裁剪白平衡（0=禁用，1=启用）
int8 colorbar                 # 彩条测试（0=禁用，1=启用）

bool enable_series_capture     # 是否启用连续拍摄模式

---

# 响应部分（Response）
# 执行结果状态
int64 id  

int32 xclk_freq_hz             # 当前XCLK时钟频率（Hz）
int16 milliseconds             # 延时参数（毫秒）
int16 aec_value                # 自动曝光值（0-1200）

int8 state       

int8 pin_pwdn                 # 当前使用的电源关闭线引脚
int8 pin_reset                # 当前使用的复位线引脚
int8 pin_xclk                 # 当前使用的XCLK时钟线引脚
int8 pin_sccb_sda             # 当前使用的SDA线引脚
int8 pin_sccb_scl             # 当前使用的SCL线引脚
int8 pin_d7                   # 当前使用的D7数据线引脚
int8 pin_d6                   # 当前使用的D6数据线引脚
int8 pin_d5                   # 当前使用的D5数据线引脚
int8 pin_d4                   # 当前使用的D4数据线引脚
int8 pin_d3                   # 当前使用的D3数据线引脚
int8 pin_d2                   # 当前使用的D2数据线引脚
int8 pin_d1                   # 当前使用的D1数据线引脚
int8 pin_d0                   # 当前使用的D0数据线引脚
int8 pin_vsync                # 当前使用的VSYNC线引脚
int8 pin_href                 # 当前使用的HREF线引脚
int8 pin_pclk                 # 当前使用的PCLK线引脚
int8 ledc_timer               # 当前使用的LEDC定时器
int8 ledc_channel             # 当前使用的LEDC通道
int8 pixel_format             # 当前像素格式
int8 frame_size               # 当前输出图像尺寸
int8 jpeg_quality             # 当前JPEG输出质量
int8 fb_count                 # 当前帧缓冲区数量
int8 fb_location              # 当前帧缓冲区分配位置
int8 grab_mode                # 当前缓冲区填充时机
int8 conv_mode                # 当前RGB<->YUV转换模式
int8 sccb_i2c_port            # 当前SCCB I2C总线端口号

int8 pixformat                # 像素格式（PIXFORMAT_*枚举值转int）
int8 framesize                # 帧大小（FRAMESIZE_*枚举值转int）
int8 quality                  # 图像质量（0-63）
int8 brightness               # 亮度（-2到+2）
int8 contrast                 # 对比度（-2到+2）
int8 saturation               # 饱和度（-2到+2）
int8 sharpness                # 锐度（-2到+2）
int8 denoise                  # 降噪等级（0-6）
int8 special_effect           # 特殊效果（0-6，如0=正常、1=负片）
int8 wb_mode                  # 白平衡模式（0-4）
int8 awb                 # 白平衡（0=禁用，1=启用）
int8 awb_gain                 # 白平衡增益（0=禁用，1=启用）
int8 aec            # 曝光控制（0=禁用，1=启用）
int8 aec2                     # 高级曝光控制（0=禁用，1=启用）
int8 ae_level                 # 曝光补偿（-2到+2）
int8 agc                # 增益控制（0=禁用，1=启用）
int8 agc_gain                 # 自动增益值（0-31）
int8 gainceiling              # 增益上限（gainceiling_t枚举值转int）
int8 bpc                      # 坏点校正（0=禁用，1=启用）
int8 wpc                      # 白点校正（0=禁用，1=启用）
int8 raw_gma                  # 原始图像GMA（0=禁用，1=启用）
int8 lenc                     # 镜头校正（0=禁用，1=启用）
int8 hmirror                  # 水平镜像（0=禁用，1=启用）
int8 vflip                    # 垂直翻转（0=禁用，1=启用）
int8 dcw                      # 数字裁剪白平衡（0=禁用，1=启用）
int8 colorbar                 # 彩条测试（0=禁用，1=启用）

bool enable_series_capture     # 当前连续拍摄模式状态