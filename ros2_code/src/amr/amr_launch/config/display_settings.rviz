        base_footprint:
          Value: true
        base_link:
          Value: true
        camera_frame:
          Value: true
        imu_frame:
          Value: true
        left_back_wheel:
          Value: true
        left_front_wheel:
          Value: true
        lidar_frame:
          Value: true
        odom:
          Value: true
        right_back_wheel:
          Value: true
        right_front_wheel:
          Value: true
        support_camera_frame:
          Value: true
        support_lidar_frame:
          Value: true
      Marker Scale: 0.10000000149011612
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        odom:
          base_footprint:
            base_link:
              imu_frame:
